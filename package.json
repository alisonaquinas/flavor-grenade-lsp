{
  "name": "flavor-grenade-lsp",
  "version": "0.4.3",
  "type": "module",
  "description": "Language Server Protocol server for Obsidian Flavored Markdown",
  "bin": {
    "flavor-grenade-lsp": "dist/main.js"
  },
  "files": [
    "dist/",
    "docs/assets/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alisonaquinas/flavor-grenade-lsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun --watch src/main.ts",
    "build": "tsc --project tsconfig.json",
    "build:binary": "node scripts/build-binary.mjs --outfile=dist/flavor-grenade-lsp --copy-to-extension",
    "build:binary:win": "node scripts/build-binary.mjs --outfile=dist/flavor-grenade-lsp.exe --target=bun-windows-x64 --copy-to-extension --binary-name=flavor-grenade-lsp.exe",
    "start": "node dist/main.js",
    "test": "bun test",
    "bdd": "bun --bun node_modules/@cucumber/cucumber/bin/cucumber-js --config cucumber.yaml",
    "lint": "eslint src/",
    "lint:dependencies": "node scripts/check-exact-dependencies.mjs",
    "lint:docs": "markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./docs \"docs/**/*.md\" && markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./website/docs \"website/docs/**/*.md\" && markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./extension/docs \"extension/docs/**/*.md\"",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/",
    "gate:1": "bun run build && bun test",
    "gate:2": "bun test src/test/integration/transport.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.23",
    "@nestjs/core": "11.1.23",
    "@nestjs/platform-express": "11.1.23",
    "@types/js-yaml": "4.0.9",
    "js-yaml": "4.1.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@jest/globals": "30.4.1",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.0",
    "lefthook": "2.1.6",
    "markdownlint-obsidian-cli": "1.1.0",
    "prettier": "3.8.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "qs": "6.15.2"
  }
}
