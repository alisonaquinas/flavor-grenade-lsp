{
  "name": "flavor-grenade-lsp",
  "version": "0.7.3",
  "type": "module",
  "description": "Language Server Protocol server for Obsidian Flavored Markdown",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "flavor-grenade-lsp": "dist/main.js"
  },
  "files": [
    "dist/",
    "docs/assets/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alisonaquinas/flavor-grenade-lsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun --watch src/main.ts",
    "build:packages": "bun run --cwd packages/markdown-flavor build",
    "build": "bun run build:packages && tsc --project tsconfig.json",
    "build:binary": "node scripts/build-binary.mjs --outfile=dist/flavor-grenade-lsp --copy-to-extension",
    "build:binary:win": "node scripts/build-binary.mjs --outfile=dist/flavor-grenade-lsp.exe --target=bun-windows-x64 --copy-to-extension --binary-name=flavor-grenade-lsp.exe",
    "start": "node dist/main.js",
    "test": "bun test",
    "test:markdown-flavor": "bun run --cwd packages/markdown-flavor test",
    "bdd": "bun --bun node_modules/@cucumber/cucumber/bin/cucumber-js --config cucumber.yaml",
    "lint": "eslint src/ packages/",
    "lint:dependencies": "node scripts/check-exact-dependencies.mjs",
    "lint:installed-packages": "node scripts/check-installed-packages.mjs . packages/markdown-flavor",
    "lint:docs": "markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./docs \"docs/**/*.md\" && markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./website/docs \"website/docs/**/*.md\" && markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./extension/docs \"extension/docs/**/*.md\" && markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./skill \"skill/docs/**/*.md\" && markdownlint-obsidian --config .obsidian-linter.jsonc --vault-root ./plugins \"plugins/**/*.md\"",
    "skill:test": "node --test ./plugins/flavorgrenade-lsp/skills/flavorgrenade-lsp/tests/wrapper-options.test.js && bun test ./plugins/flavorgrenade-lsp/skills/flavorgrenade-lsp/tests/skill-smoke.test.js",
    "skill:set-version": "node scripts/set-plugin-version.mjs",
    "skill:fetch-runtime": "node scripts/skill-fetch-runtime.mjs",
    "skill:package": "node scripts/skill-package.mjs",
    "skill:verify": "node scripts/skill-verify.mjs --allow-missing-runtime",
    "skill:marketplace:verify": "node scripts/skill-marketplace-verify.mjs",
    "skill:plugin:verify": "node scripts/skill-plugin-verify.mjs",
    "skill:release:dry-run": "node scripts/skill-package.mjs --dry-run --require-signed-runtime && node scripts/skill-marketplace-verify.mjs && node scripts/skill-plugin-verify.mjs",
    "lint:fix": "eslint src/ packages/ --fix",
    "format": "prettier --write src/ packages/",
    "typecheck": "bun run build:packages && tsc --noEmit",
    "format:check": "prettier --check src/ packages/",
    "gate:1": "bun run build && bun test",
    "gate:2": "bun test src/test/integration/transport.test.ts"
  },
  "dependencies": {
    "markdown-flavor-detection": "0.7.3",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "@types/js-yaml": "4.0.9",
    "ignore": "7.0.5",
    "js-yaml": "4.2.0",
    "jsonc-parser": "3.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "vscode-languageserver-protocol": "3.18.0",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-languageserver-types": "3.18.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "12.9.0",
    "@jest/globals": "30.4.1",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.0.0",
    "lefthook": "2.1.8",
    "markdownlint-obsidian-cli": "1.1.0",
    "prettier": "3.8.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "qs": "6.15.2"
  }
}
