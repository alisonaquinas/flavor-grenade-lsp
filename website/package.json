{
  "name": "flavor-grenade-lsp-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:generate && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json --noEmit && vite build",
    "content:generate": "tsx scripts/content/generate.ts",
    "content:check": "tsx scripts/content/check.ts",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 src tests *.config.js *.config.ts",
    "typecheck": "npm run content:generate && npm run content:check && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json --noEmit",
    "test": "npm run content:generate && npm run content:check && vitest run"
  },
  "dependencies": {
    "commonloom": "0.1.0",
    "svelte": "5.55.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "25.6.0",
    "eslint": "10.3.0",
    "eslint-plugin-svelte": "3.17.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "sass-embedded": "1.100.0",
    "svelte-check": "4.4.8",
    "tsx": "^4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "8.0.11",
    "vitest": "4.1.5",
    "zod": "^4.4.3"
  }
}
